{
  "name": "@novice1/app",
  "private": false,
  "version": "0.9.6",
  "description": "Build Express applications on top of @novice1/routing.",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "homepage": "https://kisiwu.github.io/novice-app/latest/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kisiwu/novice-app.git"
  },
  "scripts": {
    "doc": "typedoc",
    "build": "tsc",
    "format": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write .",
    "format:check": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --check .",
    "lint": "eslint .",
    "test": "cross-env TS_NODE_PROJECT=test/tsconfig.json kaukau --require ts-node/register --config kaukau-src.config.mjs",
    "test:lib": "kaukau --config kaukau-lib.config.mjs"
  },
  "author": "demingongo",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-mocha": "^12.0.2",
    "kaukau": "^6.0.0",
    "prettier": "^3.10.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@novice1/routing": "^2.1.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "dependencies": {
    "@novice1/logger": "^2.0.1",
    "tslib": "^2.9.1"
  }
}